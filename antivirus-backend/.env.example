# ── Application ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# ── Database ─────────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://avuser:avpassword@localhost:5432/antivirus_db

# Sync URL used by Alembic migrations only
DATABASE_URL_SYNC=postgresql+psycopg2://avuser:avpassword@localhost:5432/antivirus_db

# ── Redis ─────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Scan Engine ──────────────────────────────────────────────────────────────────
# Absolute path to directory containing .yar rule files
YARA_RULES_DIR=./app/rules

# Maximum file upload size in MB (enforced before disk write)
MAX_FILE_SIZE_MB=50

# Shannon entropy threshold above which a file is flagged as packed/encrypted
HIGH_ENTROPY_THRESHOLD=7.2

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS
# For Expo Go: exp://192.168.x.x:19000 or http://localhost:19006
ALLOWED_ORIGINS=http://localhost:19006,exp://localhost:19000,http://localhost:8081

# ── API Key Auth (optional) ──────────────────────────────────────────────────────
# Set to true to require X-API-Key header on all /api/v1/* requests
API_KEY_ENABLED=false
API_KEY=your-secret-api-key-here

# ── Logging ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Definition Versioning ─────────────────────────────────────────────────────────
DEFINITIONS_VERSION=v2.0.2026.08
